# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for source code
*.cpp text eol=lf
*.h text eol=lf  
*.hpp text eol=lf
*.c text eol=lf
*.rs text eol=lf
*.zig text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Force LF for scripts
*.sh text eol=lf
build.sh text eol=lf
setup_dev.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.7z binary
*.tar.gz binary
*.elf binary
*.so binary
*.dll binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary

# Archive files
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary

# Godot files
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf